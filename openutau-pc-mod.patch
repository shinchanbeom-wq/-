+using System.Collections.Generic;
+using System.Linq;
+using System.Text.RegularExpressions;
+using WanaKanaNet;
+
+namespace OpenUtau.Core.Util {
+    /// <summary>Converts plain lyrics without rewriting aliases, hints or control tokens.</summary>
+    public static class JapaneseLyricsConverter {
+        private static readonly HashSet<string> reserved = new HashSet<string>(
+            System.StringComparer.OrdinalIgnoreCase) { "R", "br", "bre", "AP", "SP", "cl" };
+        private static readonly Regex plainLyric = new Regex(@"\A[a-zA-Z'\u3041-\u3096\u30A1-\u30FA\u30FC]+\z");
+        private static readonly Regex latin = new Regex("[a-zA-Z]");
+
+        public static string ToHiragana(string lyric) => Convert(lyric, false);
+        public static string ToKatakana(string lyric) => Convert(lyric, true);
+
+        private static string Convert(string lyric, bool katakana) {
+            // Spaces, pitch suffixes, phonetic hints and punctuation indicate an
+            // explicit alias. Korean originals are left for KO to JA to process.
+            if (reserved.Contains(lyric) || !plainLyric.IsMatch(lyric)) {
+                return lyric;
+            }
+            // WanaKana expands katakana long-vowel marks into vowels. Preserve
+            // those marks when only changing script, so note text round-trips.
+            var converted = katakana ? WanaKana.ToKatakana(lyric)
+                : string.Join("ー", lyric.Split('ー').Select(part => WanaKana.ToHiragana(part)));
+            // Do not commit a partially converted English word or incomplete romaji.
+            return latin.IsMatch(converted) || converted.Contains('\'') ? lyric : converted;
+        }
+    }
+}

