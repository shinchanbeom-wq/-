@@ -0,0 +1,60 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using WanaKanaNet;
+
+namespace OpenUtau.Core.Util {
+    /// <summary>Approximate Korean pronunciation and Japanese romaji in kana.</summary>
+    public static class PronunciationLyricsConverter {
+        public const string KoreanPhonemizerName = "KO to JA Phonemizer";
+        public static bool IsKoreanSyllable(string? text) {
+            text = text?.Normalize();
+            return text != null && text.Length == 1 && text[0] >= '가' && text[0] <= '힣';
+        }
+        private static readonly Regex hangul = new Regex(@"\A[가-힣]+\z");
+        private static readonly HashSet<string> reserved = new HashSet<string>(StringComparer.OrdinalIgnoreCase) {
+            "R", "br", "bre", "AP", "SP", "cl"
+        };
+        // Same Unicode order and vowel approximations as the built-in KO to JA phonemizer.
+        private static readonly string[] initials = "g k n d t r m b p s s _ j ch ch k t p h".Split(' ');
+        private static readonly string[] vowels = "a e ya ye o e yo ye o wa we we yo u wo we wi yu u wi i".Split(' ');
+        private static readonly string[] codas = "_ ku ku ku n n n to ru ru ru ru ru ru ru ru mu pu pu to to n to to ku to pu to".Split(' ');
+        public static string Convert(string text, string? previous = null, string? next = null) {
+            if (string.IsNullOrEmpty(text) || reserved.Contains(text)) {
+                return text;
+            }
+            var normalized = text.Normalize(NormalizationForm.FormC);
+            if (hangul.IsMatch(normalized)) {
+                var result = new StringBuilder();
+                for (int i = 0; i < normalized.Length; i++) {
+                    var before = i > 0 ? normalized[i - 1].ToString() : HangulEdge(previous, false);
+                    var after = i + 1 < normalized.Length ? normalized[i + 1].ToString() : HangulEdge(next, true);
+                    var spoken = KoreanPhonemizerUtil.Variate(before, normalized[i].ToString(), after);
+                    int value = spoken[0] - '가';
+                    var onset = initials[value / 588];
+                    var vowel = vowels[value % 588 / 28];
+                    result.Append(Kana((onset == "_" ? "" : onset) + vowel));
+                    var coda = codas[value % 28];
+                    if (coda != "_") { result.Append(Kana(coda)); }
+                }
+                return result.ToString();
+            }
+            return JapaneseLyricsConverter.ToHiragana(text);
+        }
+
+        public static string[] ConvertAll(IReadOnlyList<string> lyrics) {
+            return lyrics.Select((text, i) => Convert(text,
+                i > 0 ? lyrics[i - 1] : null, i + 1 < lyrics.Count ? lyrics[i + 1] : null)).ToArray();
+        }
+
+        private static string? HangulEdge(string? text, bool first) {
+            if (string.IsNullOrEmpty(text)) { return null; }
+            text = text.Normalize(NormalizationForm.FormC);
+            return hangul.IsMatch(text) ? text[first ? 0 : text.Length - 1].ToString() : null;
+        }
+
+        private static string Kana(string romaji) => WanaKana.ToHiragana(romaji).Replace('ゔ', 'ヴ');
+    }
+}

