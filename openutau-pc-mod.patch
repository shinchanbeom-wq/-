+using OpenUtau.App.ViewModels;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using OpenUtau.Core;
+using OpenUtau.Core.Ustx;
+using OpenUtau.Core.Util;
+using ReactiveUI.Builder;
+using Xunit;
+
+namespace OpenUtau.Test.App {
+    [Collection(RenderSingletonCollection.Name)]
+    public class LyricsConversionTest {
+        static LyricsConversionTest() {
+            RxAppBuilder.CreateReactiveUIBuilder().WithCoreServices().BuildApp();
+        }
+        [Fact]
+        public void DialogConversionPreservesAliasesHintsAndNoteCount() {
+            var vm = new LyricsViewModel {
+                Text = "ka kya \"kitte\" \"a か\" \"가 [ka]\" + R"
+            };
+            vm.ConvertToHiragana();
+            Assert.Equal(new[] { "か", "きゃ", "きって", "a か", "가 [ka]", "+", "R" },
+                SplitLyrics.Split(vm.Text));
+            vm.ConvertToKatakana();
+            Assert.Equal(new[] { "カ", "キャ", "キッテ", "a か", "가 [ka]", "+", "R" },
+                SplitLyrics.Split(vm.Text));
+        }
+
+        [Theory]
+        [InlineData("unchanged", "ka", null)]
+        [InlineData("reset", "ka", null)]
+        [InlineData("cancel", "ka", null)]
+        [InlineData("korean", "가", null)]
+        [InlineData("romaji", "shi", null)]
+        [InlineData("katakana", "カ", null)]
+        public void DialogHonorsInputModeAndExplicitActions(string action, string expected, string? original) {
+            var captured = new List<NoteCommand>();
+            var priorAuto = Preferences.Default.AutoPronunciationLyrics;
+            var priorPreview = Preferences.Default.LyricLivePreview;
+            var priorSelection = Preferences.Default.LyricApplySelectionOnly;
+            try {
+                Preferences.Default.AutoPronunciationLyrics = true;
+                DocManager.Inst.CommandSink = command => {
+                    if (command is NoteCommand noteCommand) { captured.Add(noteCommand); }
+                };
+                var note = UNote.Create();
+                note.lyric = "ka";
+                var part = new UVoicePart();
+                part.notes.Add(note);
+                var vm = new LyricsViewModel { LivePreview = false, ApplySelection = false };
+                vm.Start(part, new[] { note }, Array.Empty<UNote>());
+                Assert.Empty(captured);
+                switch (action) {
+                    case "korean": vm.Text = "가"; break;
+                    case "romaji": vm.Text = "shi"; break;
+                    case "katakana": vm.ConvertToKatakana(); break;
+                    case "reset": vm.Text = "가"; vm.Reset(); break;
+                    case "cancel": vm.Text = "가"; break;
+                }
+                if (action == "cancel") { vm.Cancel(); } else { vm.Finish(); }
+                foreach (var command in captured) { command.Execute(); }
+                Assert.Equal(expected, note.lyric);
+                Assert.Equal(original, note.pronunciation);
+                if (action is "unchanged" or "reset" or "cancel") { Assert.Empty(captured); }
+            } finally {
+                DocManager.Inst.CommandSink = null;
+                Preferences.Default.AutoPronunciationLyrics = priorAuto;
+                Preferences.Default.LyricLivePreview = priorPreview;
+                Preferences.Default.LyricApplySelectionOnly = priorSelection;
+                Preferences.Save();
+            }
+        }
+    }
+}

