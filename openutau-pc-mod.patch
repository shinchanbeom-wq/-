@@ -0,0 +1,31 @@
+using OpenUtau.Core.Ustx;
+
+namespace OpenUtau.Core {
+    /// <summary>Edits pronunciation without changing the displayed lyric.</summary>
+    public class ChangeNotePronunciationCommand : NoteCommand {
+        private readonly UNote note;
+        private readonly string? oldPronunciation;
+        private readonly string? newPronunciation;
+
+        public ChangeNotePronunciationCommand(UVoicePart part, UNote note, string? pronunciation)
+            : base(part, note) {
+            this.note = note;
+            oldPronunciation = note.pronunciation;
+            newPronunciation = string.IsNullOrWhiteSpace(pronunciation) ? null : pronunciation.Trim();
+        }
+
+        public override string ToString() => "Change note pronunciation";
+
+        public override void Execute() {
+            lock (Part) {
+                note.pronunciation = newPronunciation;
+            }
+        }
+
+        public override void Unexecute() {
+            lock (Part) {
+                note.pronunciation = oldPronunciation;
+            }
+        }
+    }
+}
